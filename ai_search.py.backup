import base64
import json
import math
import os
from pathlib import Path
from openai import OpenAI


def get_client():
    # Keep the provider key on the backend only.
    key = os.getenv("OPENAI_API_KEY", "").strip()
    if not key:
        return None
    return OpenAI(api_key=key)


def describe_image(path: Path, mime_type: str) -> str:
    client = get_client()
    if client is None:
        return ""
    encoded = base64.b64encode(path.read_bytes()).decode("utf-8")
    response = client.responses.create(
        model=os.getenv("OPENAI_VISION_MODEL", "gpt-4.1-mini"),
        input=[{
            "role": "user",
            "content": [
                {"type": "input_text", "text": (
                    "Describe this image for a multimedia library search. "
                    "Mention visible objects, people, setting, actions, colors, "
                    "and useful search keywords. Be concise and factual. Do not guess identities."
                )},
                {"type": "input_image", "image_url": f"data:{mime_type};base64,{encoded}"},
            ],
        }],
    )
    return response.output_text.strip()


def make_embedding(text: str):
    client = get_client()
    if client is None or not text.strip():
        return None
    result = client.embeddings.create(
        model=os.getenv("OPENAI_EMBEDDING_MODEL", "text-embedding-3-small"),
        input=text[:8000],
    )
    return result.data[0].embedding


def cosine_similarity(a, b):
    if not a or not b or len(a) != len(b):
        return 0.0
    dot = sum(x * y for x, y in zip(a, b))
    norm_a = math.sqrt(sum(x * x for x in a))
    norm_b = math.sqrt(sum(y * y for y in b))
    return dot / (norm_a * norm_b) if norm_a and norm_b else 0.0


def search_media(query: str, rows):
    query_vector = make_embedding(query)
    if query_vector is None:
        q = query.casefold()
        return [dict(row) for row in rows if q in row["filename"].casefold()
                or q in row["description"].casefold()]
    ranked = []
    for row in rows:
        try:
            vector = json.loads(row["embedding"]) if row["embedding"] else None
        except (TypeError, json.JSONDecodeError):
            vector = None
        score = cosine_similarity(query_vector, vector)
        if score > 0:
            item = dict(row)
            item["similarity"] = round(score, 4)
            ranked.append(item)
    ranked.sort(key=lambda item: item["similarity"], reverse=True)
    return ranked
